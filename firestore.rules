rules_version = '2';

// Regras de FORMATO, não de identidade — este projeto não usa Firebase Auth
// (mesmo trade-off do padrão de referência, Financeiro Pamplona). Isso barra
// gravações mal-formadas, mas não impede alguém tecnicamente hábil de abrir
// o DevTools e escrever fora das regras de negócio do app.js. Trade-off
// aceitável pra uso interno da equipe — como este sistema guarda dados
// financeiros e de clientes, reavalie introduzir Firebase Auth se o número
// de pessoas com acesso crescer.
service cloud.firestore {
  match /databases/{database}/documents {

    match /clientes/{id} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasAll(['nome'])
                    && request.resource.data.nome is string
                    && request.resource.data.nome.size() > 0
                    && request.resource.data.nome.size() < 200;
      allow update: if request.resource.data.nome is string
                    && request.resource.data.nome.size() < 200;
      allow delete: if true;
    }

    match /agendamentos/{id} {
      allow read: if true;
      allow create, update: if request.resource.data.keys().hasAll(['clienteNome', 'etapa'])
                    && request.resource.data.clienteNome is string
                    && request.resource.data.etapa is string;
      allow delete: if true;

      match /historico/{logId} {
        allow read: if true;
        allow create: if true;
        // Nunca editar um evento já gravado (update: false — log é
        // append-only de verdade), mas PRECISA permitir apagar: quando o
        // card pai é excluído, o app.js apaga o histórico junto (exclusão
        // em cascata) — sem isso, "Missing or insufficient permissions"
        // ao excluir, e o histórico órfão fica pra sempre no banco.
        allow update: if false;
        allow delete: if true;
      }
    }

    match /etapasAgendamentoConfig/{id} {
      allow read: if true;
      allow create, update: if request.resource.data.nome is string
                    && request.resource.data.ordem is number;
      allow delete: if true;
    }

    match /etapasVendaConfig/{id} {
      allow read: if true;
      allow create, update: if request.resource.data.nome is string
                    && request.resource.data.ordem is number;
      allow delete: if true;
    }

    match /oportunidades/{id} {
      allow read: if true;
      allow create, update: if request.resource.data.keys().hasAll(['clienteNome', 'etapa'])
                    && request.resource.data.clienteNome is string
                    && request.resource.data.etapa is string;
      allow delete: if true;

      match /historico/{logId} {
        allow read: if true;
        allow create: if true;
        // Nunca editar um evento já gravado (update: false — log é
        // append-only de verdade), mas PRECISA permitir apagar: quando o
        // card pai é excluído, o app.js apaga o histórico junto (exclusão
        // em cascata) — sem isso, "Missing or insufficient permissions"
        // ao excluir, e o histórico órfão fica pra sempre no banco.
        allow update: if false;
        allow delete: if true;
      }
    }

    match /contratos/{id} {
      allow read: if true;
      allow create, update: if request.resource.data.keys().hasAll(['clienteNome', 'valorTotal'])
                    && request.resource.data.clienteNome is string
                    && request.resource.data.valorTotal is number;
      allow delete: if true;
    }

    match /parcelas/{id} {
      allow read: if true;
      allow create, update: if request.resource.data.keys().hasAll(['contratoId', 'valor', 'vencimento', 'status'])
                    && request.resource.data.contratoId is string
                    && request.resource.data.valor is number
                    && request.resource.data.status is string;
      allow delete: if true;
    }

    match /despesas/{id} {
      allow read: if true;
      allow create, update: if request.resource.data.keys().hasAll(['descricao', 'valor', 'tipo'])
                    && request.resource.data.descricao is string
                    && request.resource.data.valor is number
                    && request.resource.data.tipo is string;
      allow delete: if true;
    }

    match /entradas/{id} {
      allow read: if true;
      allow create, update: if request.resource.data.keys().hasAll(['descricao', 'valor', 'status'])
                    && request.resource.data.descricao is string
                    && request.resource.data.valor is number
                    && request.resource.data.status is string;
      allow delete: if true;
    }

    match /etapasAdminConfig/{id} {
      allow read: if true;
      allow create, update: if request.resource.data.keys().hasAll(['nome', 'ordem'])
                    && request.resource.data.nome is string
                    && request.resource.data.ordem is number;
      allow delete: if true;
    }

    match /cardsAdmin/{id} {
      allow read: if true;
      allow create, update: if request.resource.data.keys().hasAll(['clienteNome', 'etapa'])
                    && request.resource.data.clienteNome is string
                    && request.resource.data.etapa is string;
      allow delete: if true;

      match /historico/{logId} {
        allow read: if true;
        allow create: if true;
        // Nunca editar um evento já gravado (update: false — log é
        // append-only de verdade), mas PRECISA permitir apagar: quando o
        // card pai é excluído, o app.js apaga o histórico junto (exclusão
        // em cascata) — sem isso, "Missing or insufficient permissions"
        // ao excluir, e o histórico órfão fica pra sempre no banco.
        allow update: if false;
        allow delete: if true;
      }
    }

    match /config/{id} {
      allow read: if true;
      allow write: if true;
    }
  }
}
